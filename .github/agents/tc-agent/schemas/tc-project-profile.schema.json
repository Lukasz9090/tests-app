{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc-project-profile.schema.json",
  "title": "project-profile",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_coverage_target_scope": {"type": "number", "minimum": 0, "maximum": 1},
        "mutation_score_target_scope": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jacoco_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
        "pit_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"}
      }
    },
    "protected_branches": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "max_rounds": {"type": "integer", "minimum": 1},
    "freshness_days": {"type": "number", "minimum": 0},
    "flaky_repeat": {"type": "integer", "minimum": 1},
    "instruction_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "maven_timeout_seconds": {"type": "number", "minimum": 1},
    "maven_also_make": {"oneOf": [{"type": "boolean"}, {"const": "auto"}]},
    "maven_skip_main_compile": {"oneOf": [{"type": "boolean"}, {"enum": ["auto", "strict"]}]},
    "junit": {"enum": ["4", "5"]},
    "maven_goals_only": {"type": "boolean"},
    "maven_args": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "maven_snapshot_updates": {"type": "boolean"},
    "test_data_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
