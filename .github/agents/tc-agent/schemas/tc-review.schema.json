{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc-review.schema.json",
  "title": "review",
  "type": "object",
  "required": ["schema_version", "plan_version", "decision", "checks", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "decision": {"enum": ["ACCEPT", "ACCEPT_PARTIAL", "REPAIR_IMPLEMENTATION", "REPAIR_PLAN", "NEEDS_TRIAGE", "BLOCKED"]},
    "checks": {
      "type": "object",
      "required": ["tests"],
      "additionalProperties": false,
      "properties": {
        "tests": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["PASSED", "FAILED", "COMPILE_ERROR", "UNAVAILABLE"]},
            "reason": {"type": "string"},
            "flaky_only": {"type": "boolean"}
          }
        },
        "coverage": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {"status": {"enum": ["PASSED", "FAILED", "SKIPPED", "UNAVAILABLE"]}, "reason": {"type": "string"}}
        },
        "mutation": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["PASSED", "FAILED", "SKIPPED", "SKIPPED_UNAVAILABLE"]},
            "reason": {"type": "string"}
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "severity", "attributed_to", "message"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "compile_error",
              "test_failure",
              "scenario_not_implemented",
              "missing_scenario",
              "uncovered_branch",
              "survivor_mutant",
              "weak_assertion",
              "duplicate_test",
              "flaky_risk",
              "unreadable_setup",
              "metadata_defect",
              "missing_placeholder",
              "convention",
              "spec_mismatch"
            ]
          },
          "severity": {"enum": ["blocker", "major", "minor"]},
          "attributed_to": {"enum": ["implementation", "plan", "code", "environment"]},
          "message": {"type": "string"},
          "location": {"type": "string"},
          "tc": {"type": "array", "items": {"type": "string", "pattern": "^TC[0-9]+$"}},
          "test_method": {"type": "string"},
          "checked_scenarios": {"type": "array", "items": {"type": "string", "pattern": "^TC[0-9]+$"}},
          "repeated": {"type": "boolean"}
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["request"],
            "additionalProperties": false,
            "properties": {
              "tc": {"type": "array", "items": {"type": "string", "pattern": "^TC[0-9]+$"}},
              "location": {"type": "string"},
              "request": {"type": "string"},
              "scope": {"enum": ["assertion", "setup", "test", "disable"]}
            }
          }
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["request"],
            "additionalProperties": false,
            "properties": {
              "tc": {"type": "array", "items": {"type": "string", "pattern": "^TC[0-9]+$"}},
              "location": {"type": "string"},
              "request": {"type": "string"}
            }
          }
        }
      }
    },
    "unimplementable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^TC[0-9]+$"},
          "test_method": {"type": "string"},
          "reason": {"type": "string"},
          "suggestion": {"type": "string"}
        }
      }
    },
    "commit_summary": {"type": "string", "minLength": 40}
  },
  "allOf": [
    {
      "if": {"required": ["decision"], "properties": {"decision": {"enum": ["ACCEPT", "ACCEPT_PARTIAL"]}}},
      "then": {"required": ["commit_summary"]},
      "errorMessage": "ACCEPT / ACCEPT_PARTIAL needs `commit_summary`: 2-5 English sentences that go into the commit message and the run report."
    }
  ]
}
