{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc-test-plan.schema.json",
  "title": "test-plan",
  "type": "object",
  "required": ["schema_version", "plan_version", "mode", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["characterization", "spec-driven"]},
    "status": {"enum": ["READY", "READY_PARTIAL", "COMPLETE", "NEEDS_CLARIFICATION", "BLOCKED"]},
    "reason": {"type": "string", "minLength": 5},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existing_tests": {"type": "array", "items": {"type": "string"}},
        "target_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "test_data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concept", "examples"],
            "additionalProperties": false,
            "properties": {
              "concept": {"type": "string"},
              "rule": {"type": "string"},
              "examples": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "applies_to": {"type": "array", "items": {"type": "string"}},
              "used_by": {"type": "array", "items": {"type": "string", "pattern": "^TC[0-9]+$"}}
            }
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}},
    "deferred": {"type": "array", "items": {"$ref": "#/$defs/deferred"}},
    "obsolete": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "reason"],
        "additionalProperties": false,
        "properties": {
          "test": {"type": "string", "pattern": "^[A-Za-z_$][\\w$]*#[A-Za-z_$][\\w$]*$"},
          "reason": {"type": "string", "minLength": 5}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "READY"}}},
      "then": {"required": ["scenarios"], "properties": {"scenarios": {"minItems": 1}, "deferred": {"maxItems": 0}}},
      "errorMessage": "READY = at least one scenario and nothing deferred. With deferred scenarios the status is READY_PARTIAL."
    },
    {
      "if": {"properties": {"status": {"const": "READY_PARTIAL"}}},
      "then": {"required": ["scenarios", "deferred"], "properties": {"deferred": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "COMPLETE"}}},
      "then": {"properties": {"scenarios": {"maxItems": 0}, "deferred": {"maxItems": 0}}},
      "errorMessage": "COMPLETE means there is nothing for the Generator to write: no scenarios and no deferred entries; `reason` says which tests or placeholders explain the remaining gap."
    },
    {
      "if": {"properties": {"status": {"enum": ["COMPLETE", "BLOCKED", "NEEDS_CLARIFICATION"]}}},
      "then": {"required": ["reason"]},
      "errorMessage": "COMPLETE, BLOCKED and NEEDS_CLARIFICATION need `reason` - it is what the run report shows the human (for a spec conflict: quote both passages)."
    },
    {
      "if": {"properties": {"status": {"enum": ["READY", "READY_PARTIAL"]}}},
      "then": {"properties": {"scenarios": {"items": {"required": ["evidence_strength"]}}}},
      "errorMessage": "every scenario of a READY / READY_PARTIAL plan needs `evidence_strength`, which tc_evidence_strength.py fills."
    },
    {
      "if": {"properties": {"mode": {"const": "characterization"}}},
      "then": {"required": ["context"], "properties": {"context": {"required": ["target_sha"]}}},
      "errorMessage": "a characterization plan freezes one version of the code: `context.target_sha` = git.current_sha from derive-state.md."
    },
    {
      "if": {"properties": {"mode": {"const": "spec-driven"}}},
      "then": {
        "properties": {
          "scenarios": {"items": {"required": ["requirement"]}},
          "deferred": {"items": {"required": ["requirement"]}}
        }
      },
      "errorMessage": "a spec-driven scenario comes from a spec requirement: name it in `requirement` (id or heading)."
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "human_decision",
            "existing_test",
            "builder",
            "fixture",
            "usage",
            "implementation",
            "enum",
            "db_constraint",
            "api_schema"
          ]
        },
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "description", "evidence", "implementation_hints"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^TC[0-9]+$"},
        "description": {"type": "string", "minLength": 5},
        "requirement": {"type": "string", "minLength": 1},
        "replaces": {"type": "string", "pattern": "^[A-Za-z_$][\\w$]*#[A-Za-z_$][\\w$]*$"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1},
        "evidence_strength": {"enum": ["strong", "medium", "weak"]},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "data": {"type": "object"},
        "implementation_hints": {
          "type": "object",
          "required": ["test_method", "test_file"],
          "additionalProperties": false,
          "properties": {
            "test_method": {"type": "string", "pattern": "^[A-Za-z_$][\\w$]*$"},
            "test_file": {"type": "string", "pattern": "\\.java$"}
          }
        }
      }
    },
    "deferred": {
      "type": "object",
      "required": ["id", "description", "reason", "placeholder_method"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^TC[0-9]+$"},
        "description": {"type": "string", "minLength": 5},
        "requirement": {"type": "string", "minLength": 1},
        "replaces": {"type": "string", "pattern": "^[A-Za-z_$][\\w$]*#[A-Za-z_$][\\w$]*$"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 1},
        "evidence_strength": {"enum": ["strong", "medium", "weak"]},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "reason": {"type": "string", "minLength": 5},
        "question": {"type": "string"},
        "placeholder_method": {"type": "string", "pattern": "^[A-Za-z_$][\\w$]*$"},
        "test_file": {"type": "string", "pattern": "\\.java$"}
      }
    }
  }
}
