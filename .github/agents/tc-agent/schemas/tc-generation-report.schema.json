{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc-generation-report.schema.json",
  "title": "generation-report",
  "type": "object",
  "required": ["schema_version", "plan_version", "test_files", "results"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "test_files": {"type": "array", "items": {"type": "string", "pattern": "\\.java$"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "test_method"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^TC[0-9]+$"},
          "status": {"enum": ["IMPLEMENTED", "PLACEHOLDER", "SKIPPED"]},
          "test_method": {"type": "string", "pattern": "^[A-Za-z_$][\\w$]*$"},
          "reason": {"type": "string"},
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "PLACEHOLDER"}}},
            "then": {"required": ["reason"]},
            "errorMessage": "a PLACEHOLDER must say why (`reason`) - the same text goes into its tc-agent-deferred: tag."
          }
        ]
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suggestion", "rationale"],
        "additionalProperties": false,
        "properties": {
          "related": {"type": "array", "items": {"type": "string", "pattern": "^TC[0-9]+$"}},
          "suggestion": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
