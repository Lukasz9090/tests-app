{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc-generation-report.schema.json",
  "title": "generation-report (Model B)",
  "type": "object",
  "required": [
    "schema_version",
    "plan_version",
    "target",
    "test_files",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "test_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\.java$"
      },
      "description": "Every test file this generation wrote or changed (repo-relative). `finish --commit` stages exactly these."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Run-level facts the Reviewer must see, e.g. a missing context pack, or a repo instruction that contradicted §A and was not followed."
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "test_method"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC[0-9]+$"
          },
          "status": {
            "enum": [
              "IMPLEMENTED",
              "PLACEHOLDER",
              "SKIPPED"
            ],
            "description": "IMPLEMENTED = a working test was written or repaired. PLACEHOLDER = an @Disabled method with @deferred was written (deferred scenario, or one that cannot be implemented soundly, including a compile error you could not fix). SKIPPED = a repair round left this method untouched."
          },
          "test_method": {
            "type": "string",
            "pattern": "^[A-Za-z_$][\\w$]*$"
          },
          "reason": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PLACEHOLDER"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            },
            "errorMessage": "a PLACEHOLDER must say why (`reason`) - the same text goes into its @deferred tag."
          }
        ]
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "related",
          "suggestion",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "related": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^TC[0-9]+$"
            }
          },
          "suggestion": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}