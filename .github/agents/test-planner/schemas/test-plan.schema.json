{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-plan.schema.json",
  "title": "test-plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_version",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "based_on_version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mode": {
      "enum": [
        "legacy",
        "spec-driven",
        "interactive",
        "tdd"
      ]
    },
    "characterization": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "READY",
        "READY_PARTIAL",
        "NEEDS_CLARIFICATION",
        "BLOCKED",
        "UNSUPPORTED_REPOSITORY"
      ]
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict": {
      "type": "object",
      "required": [
        "specification",
        "implementation"
      ],
      "properties": {
        "specification": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existing_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "builders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relevant_enums": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferredScenario"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "mode",
          "scenarios"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY_PARTIAL"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "mode",
          "scenarios",
          "deferred"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNSUPPORTED_REPOSITORY"
          }
        }
      },
      "then": {
        "required": [
          "missing"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "legacy"
          }
        }
      },
      "then": {
        "required": [
          "characterization"
        ]
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "type",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "human_decision",
            "existing_test",
            "builder",
            "fixture",
            "usage",
            "enum",
            "db_constraint",
            "api_schema",
            "runtime_observation",
            "dynamic_invariant"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "change",
        "description",
        "priority",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC[0-9]+$"
        },
        "change": {
          "enum": [
            "UNCHANGED",
            "MODIFIED",
            "NEW",
            "REMOVED"
          ]
        },
        "split_from": {
          "type": "string",
          "pattern": "^TC[0-9]+$",
          "description": "For NEW scenarios extracted from a previous bundled scenario."
        },
        "change_reason": {
          "type": "string",
          "description": "Required in spirit for REMOVED: why this scenario is dropped."
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "data": {
          "type": "object"
        },
        "expected_result": {
          "enum": [
            "pass",
            "fail_red"
          ],
          "description": "Reserved for future TDD mode. Default/absent = pass."
        },
        "implementation_hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "test_class": {
              "type": "string"
            },
            "test_method": {
              "type": "string"
            },
            "test_file": {
              "type": "string"
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_strength": {
          "enum": [
            "strong",
            "medium",
            "weak"
          ],
          "description": "Rule-based evidence strength (script-free v0 flow)."
        }
      }
    },
    "deferredScenario": {
      "type": "object",
      "required": [
        "id",
        "description",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 5
        },
        "question": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_strength": {
          "enum": [
            "strong",
            "medium",
            "weak"
          ],
          "description": "Rule-based evidence strength (script-free v0 flow)."
        },
        "change": {
          "enum": [
            "UNCHANGED",
            "MODIFIED",
            "NEW",
            "REMOVED"
          ]
        },
        "change_reason": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  }
}
