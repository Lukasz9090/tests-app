{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-report.schema.json",
  "title": "generation-report",
  "type": "object",
  "required": [
    "schema_version",
    "plan_version",
    "target",
    "test_files",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "test_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC[0-9]+$"
          },
          "status": {
            "enum": [
              "IMPLEMENTED",
              "BLOCKED",
              "SKIPPED"
            ]
          },
          "test_method": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "BLOCKED"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "IMPLEMENTED"
                }
              }
            },
            "then": {
              "required": [
                "test_method"
              ]
            }
          }
        ]
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "related",
          "suggestion",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "related": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^TC[0-9]+$"
            }
          },
          "suggestion": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    }
  }
}
