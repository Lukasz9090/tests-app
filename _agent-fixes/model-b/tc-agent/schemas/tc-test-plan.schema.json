{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tc-test-plan.schema.json",
  "title": "test-plan (Model B)",
  "type": "object",
  "required": [
    "schema_version",
    "plan_version",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Numbering inside ONE run only (plan_cap). Never read across runs."
    },
    "target": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "OMIT entirely for a whole-class target — never null, never empty."
        }
      }
    },
    "mode": {
      "enum": [
        "legacy",
        "spec-driven"
      ],
      "description": "Copied from run.json."
    },
    "interactive": {
      "type": "boolean",
      "description": "Copied from run.json."
    },
    "characterization": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "READY",
        "READY_PARTIAL",
        "COMPLETE",
        "NEEDS_CLARIFICATION",
        "BLOCKED",
        "UNSUPPORTED_REPOSITORY"
      ],
      "description": "COMPLETE = nothing to generate: the whole gap derive-state reported is explained by existing tests or placeholders (`gap_explanation`). A success state."
    },
    "reason": {
      "type": "string",
      "minLength": 5
    },
    "gap_explanation": {
      "type": "string",
      "minLength": 10
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict": {
      "type": "object",
      "required": [
        "specification",
        "implementation"
      ],
      "additionalProperties": false,
      "properties": {
        "specification": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existing_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "builders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relevant_enums": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "Abbreviated sha (%h) of the last commit that touched the target - copy git.current_sha from derive-state.md. Every legacy test written from this plan quotes it in tc-agent-characterizes."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferredScenario"
      }
    },
    "obsolete": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "test": {
            "type": "string",
            "pattern": "^[A-Za-z_$][\\w$]*#[A-Za-z_$][\\w$]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          }
        }
      },
      "description": "Existing tests whose behaviour is gone. A recommendation to a human, never deleted by the pipeline."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "mode",
          "scenarios"
        ],
        "properties": {
          "scenarios": {
            "minItems": 1
          },
          "deferred": {
            "maxItems": 0
          }
        }
      },
      "errorMessage": "READY = at least one scenario and nothing deferred. With deferred scenarios the status is READY_PARTIAL."
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY_PARTIAL"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "mode",
          "scenarios",
          "deferred"
        ],
        "properties": {
          "deferred": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "required": [
          "target",
          "mode",
          "gap_explanation"
        ],
        "properties": {
          "scenarios": {
            "maxItems": 0
          },
          "deferred": {
            "maxItems": 0
          }
        }
      },
      "errorMessage": "COMPLETE means there is nothing for the Generator to write: no scenarios, no deferred entries, and `gap_explanation` says why the remaining gap needs no new test (which placeholders or tests explain it)."
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_CLARIFICATION"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "conflict"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNSUPPORTED_REPOSITORY"
          }
        }
      },
      "then": {
        "required": [
          "missing"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "READY",
              "READY_PARTIAL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "scenarios": {
            "items": {
              "required": [
                "evidence_strength"
              ]
            }
          }
        }
      },
      "errorMessage": "every scenario of a READY / READY_PARTIAL plan needs `evidence_strength`, which tc_evidence_strength.py fills. A plan without it skipped that step, so nothing decided whether a scenario belongs in `scenarios` or in `deferred`."
    },
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "legacy"
          }
        }
      },
      "then": {
        "required": [
          "characterization"
        ],
        "properties": {
          "characterization": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "characterization"
        ],
        "properties": {
          "characterization": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "context"
        ],
        "properties": {
          "context": {
            "required": [
              "target_sha"
            ]
          }
        }
      },
      "errorMessage": "a characterization plan freezes one version of the code, so `context.target_sha` must name it (git.current_sha from derive-state.md). Every test written from the plan quotes it in tc-agent-characterizes."
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "type",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "human_decision",
            "existing_test",
            "builder",
            "fixture",
            "usage",
            "implementation",
            "enum",
            "db_constraint",
            "api_schema"
          ],
          "description": "`implementation` = the source lines of the code under test. In legacy/characterization mode it is legitimate evidence on its own, because such a plan freezes what the code does today; in spec-driven mode it is not a substitute for the spec."
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strength": {
      "enum": [
        "strong",
        "medium",
        "weak"
      ]
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "description",
        "priority",
        "evidence",
        "implementation_hints"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^TC[0-9]+$"
            }
          ],
          "description": "Valid inside this run only; never written into the code."
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "replaces": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_$][\\w$]*#[A-Za-z_$][\\w$]*$"
            }
          ],
          "description": "An existing test the Generator rewrites: a stale characterization test to re-characterize, or a placeholder this scenario now implements."
        },
        "data": {
          "type": "object"
        },
        "implementation_hints": {
          "type": "object",
          "required": [
            "test_method",
            "test_file"
          ],
          "additionalProperties": false,
          "description": "The traceability key of Model B: the scenario lives in the code as THIS method. Name it by the naming rule in force (tc-test-conventions.md §B1 unless REPO CONVENTIONS override it).",
          "properties": {
            "test_class": {
              "type": "string"
            },
            "test_method": {
              "type": "string",
              "pattern": "^[A-Za-z_$][\\w$]*$"
            },
            "test_file": {
              "type": "string",
              "pattern": "\\.java$"
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_strength": {
          "$ref": "#/$defs/strength"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "description": "Each entry becomes an tc-agent-note: line on the test method (a frozen known bug, a human's answer from interactive mode)."
        }
      }
    },
    "deferredScenario": {
      "type": "object",
      "required": [
        "id",
        "description",
        "reason",
        "placeholder_method"
      ],
      "additionalProperties": false,
      "description": "Becomes an @Disabled placeholder in the code (tc-test-conventions.md §A2).",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "reason": {
          "type": "string",
          "minLength": 5
        },
        "question": {
          "type": "string"
        },
        "placeholder_method": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*$"
        },
        "test_file": {
          "type": "string",
          "pattern": "\\.java$"
        },
        "replaces": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*#[A-Za-z_$][\\w$]*$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_strength": {
          "$ref": "#/$defs/strength"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "description": "Each entry becomes an tc-agent-note: line on the test method (a frozen known bug, a human's answer from interactive mode)."
        }
      }
    }
  }
}